    "@types/luxon": "^3.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "esbuild": "^0.28.2"
